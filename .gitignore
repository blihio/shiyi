# 依赖
node_modules/
.pnpm-store/

# 锁文件不提交（大家用的包管理器可能不同，避免互相覆盖）
pnpm-lock.yaml
package-lock.json
yarn.lock

# 构建产物
dist/
build/
*.tsbuildinfo

# 运行时数据（照片和数据库不进仓库，但保留目录结构）
data/*
!data/.gitkeep

# 环境变量：api/.env 是开发用的默认配置，故意提交；
# 下面这些是个人覆盖文件，不进仓库
.env.local
*.env.local
.env.production
*.secret

# Python
__pycache__/
*.py[cod]
.venv/
venv/
ai/models/
ai/data/

# IntelliJ IDEA（只忽略个人文件，.idea/vcs.xml 等共享配置会提交）
.idea/workspace.xml
.idea/usage.statistics.xml
.idea/tasks.xml
.idea/shelf/
.idea/httpRequests/
.idea/misc.xml
.idea/modules.xml
.idea/inspectionProfiles/
*.iws
*.iml

# VS Code
.vscode/*
!.vscode/extensions.json

# 日志与临时文件
*.log
.DS_Store
Thumbs.db

# 测试产物
api/prisma/test.db
api/prisma/test.db-journal
api/.test-data/
